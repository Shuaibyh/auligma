# Configuración local: copia a .env y completa los valores privados.
NODE_ENV=development
FRONTEND_URL=http://127.0.0.1:5173
BACKEND_URL=http://127.0.0.1:3001
DATABASE_URL=
# Base dedicada exclusivamente a pruebas de integración PostgreSQL.
DATABASE_TEST_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_HOURS=8
ENABLE_PILOT_TEACHERS=false
PILOT_TEACHER_EMAILS=
# Solo para desarrollo explícito; nunca permite entrar a la API.
VITE_DEMO_MODE=false
AI_PROVIDER=ollama
# Ollama debe escuchar exclusivamente en loopback. No se usan claves de nube.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Modelos permitidos fijados en el adaptador: qwen3:4b y qwen3-vl:2b.
OLLAMA_TIMEOUT_MS=120000
