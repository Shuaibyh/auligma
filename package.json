{
  "name": "auligma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:server": "tsc -p server/tsconfig.build.json",
    "start": "node --env-file-if-exists=.env build/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:local-ai": "tsx --env-file-if-exists=.env scripts/start-local-ai.ts",
    "start:server": "tsx --env-file-if-exists=.env server/index.ts",
    "db:migrate": "tsx --env-file-if-exists=.env server/manage.ts migrate",
    "db:cleanup": "tsx --env-file-if-exists=.env server/manage.ts cleanup",
    "teacher:authorize": "tsx --env-file-if-exists=.env server/manage.ts authorize",
    "teacher:revoke": "tsx --env-file-if-exists=.env server/manage.ts revoke",
    "test:server": "tsx --env-file-if-exists=.env --test server/tests/*.test.ts",
    "test:e2e:real": "playwright test --config playwright.real.config.ts",
    "test:e2e:local-ai": "playwright test --config playwright.local-ai.config.ts",
    "lint": "eslint .",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@google/genai": "^2.32.0",
    "@radix-ui/react-dialog": "1.3.1",
    "fastify": "^5.12.7",
    "jose": "^6.2.14",
    "katex": "0.19.1",
    "knex": "^3.3.0",
    "lucide-react": "1.61.0",
    "pdfjs-dist": "^5.4.394",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "read-excel-file": "9.3.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "write-excel-file": "4.1.1"
  }
}
